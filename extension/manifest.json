{
  "manifest_version": 3,
  "name": "Chess break: back to Claude",
  "version": "0.1.0",
  "description": "Back to Claude on the chess break board switches to your open Claude tab instead of opening a new one.",
  "permissions": ["tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*", "https://*.claudeusercontent.com/*"],
      "js": ["board.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
